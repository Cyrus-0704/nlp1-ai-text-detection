# Each member keeps installed environments and machine configuration local.
.local/
.venv/
venv/
envs/
.conda/
.python-version
.env
.env.*
!.env.example
.vscode/
.idea/
*.code-workspace
environment/

# Downloadable models, personal experiments, caches and temporary files.
models/
main_model/synthetic/
runs/
outputs/
checkpoints/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
hf-cache/
wandb/
mlruns/
*.log
*.tmp
*.part
*.bak
*LOCAL_SETUP*
local_settings.*

# Credentials must never be committed.
*.pem
*.key
credentials.json
token.json
id_rsa*
id_ed25519*

# Incidental training weights are local; explicitly shared models go below.
*.safetensors
*.pt
*.pth
*.bin
!handoffs/shared_models/**/*.safetensors
!handoffs/shared_models/**/*.pt
!handoffs/shared_models/**/*.pth
!handoffs/shared_models/**/*.bin

# OS metadata.
.DS_Store
Thumbs.db
desktop.ini

# --- A: 本地原始数据副本与临时产物(禁止入库) ---
# 原始数据正式文件即仓库根 data.jsonl(由 LFS 管理), 不再上传第二份副本。
data/data.jsonl
data.7z
# 划分数据副本(约352MB, 走 LFS); 本轮不上传, 只提交脚本/manifest/审计。
# 数据由接收方按 manifest 的 generation.command 本地生成并用 sha256 核对。
/train.jsonl
/dev.jsonl
/test.jsonl
data/processed/**/*.jsonl
# 本机探索/清洗日志, 不作为交付物。
explore_output.txt
preprocess_log.txt
