* text=auto eol=lf
*.ps1 text eol=crlf

# Dataset and explicit model handoffs use LFS, not regular Git blobs.
*.jsonl filter=lfs diff=lfs merge=lfs -text
*.jsonl.gz filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.tsv filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.arrow filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
# A: V1 运行证据(JSON/CSV)须字节保真, 禁止任何换行/编码转换; CSV 走 LFS 但 -text 保证不转字节
handoffs/A/v1_runs_*/** -text
handoffs/A/v1_runs_*/**/*.csv filter=lfs diff=lfs merge=lfs -text
# A: D42 smoke 证据包(JSON/CSV/LOG/ZIP)须字节保真, 禁止任何换行/编码转换; CSV/ZIP 走 LFS 但 -text 保证不转字节
handoffs/A/d42_calibrated_smoke_evidence/** -text
handoffs/A/d42_calibrated_smoke_evidence/**/*.csv filter=lfs diff=lfs merge=lfs -text
# A: V1 CUDA 证据包(JSON/CSV/ZIP)须字节保真, 禁止任何换行/编码转换; CSV/ZIP 走 LFS 但 -text 保证不转字节
handoffs/A/v1_cuda_evidence/** -text
handoffs/A/v1_cuda_evidence/**/*.csv filter=lfs diff=lfs merge=lfs -text
